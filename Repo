local function clearShield()
	if suite.ShieldPart then
		pcall(function()
			suite.ShieldPart:Destroy()
		end)
		suite.ShieldPart = nil
	end
end

function suite.Api.SyncShield(rootPart: BasePart?)
	if not suite.IsBlocking or not rootPart then
		clearShield()
		return
	end

	local shield = suite.ShieldPart
	if not shield or not shield.Parent then
		shield = Instance.new("Part")
		shield.Name = "GakuranLordShield"
		shield.Shape = Enum.PartType.Block
		shield.Material = Enum.Material.ForceField
		shield.Color = Color3.fromRGB(90, 215, 255)
		shield.Anchored = true
		shield.CanCollide = false
		shield.Transparency = 0.35
		shield.Size = Vector3.new(5.6, 5.6, 0.7)
		shield.Parent = workspace
		suite.ShieldPart = shield
	end

	local lookFlat = Vector3.new(rootPart.CFrame.LookVector.X, 0, rootPart.CFrame.LookVector.Z)
	local dir = lookFlat.Magnitude > 0.01 and lookFlat.Unit or Vector3.new(0, 0, -1)
	local frontPos = rootPart.Position + dir * 2.85
	shield.CFrame = CFrame.lookAt(frontPos, frontPos + dir)
end

local function playParryFeedback(rootPart: BasePart)
	if suite.AnimBusy then
		return
	end
	suite.AnimBusy = true

	local ring = Instance.new("Part")
	ring.Name = "GakuranParryRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(120, 235, 255)
	ring.Anchored = true
	ring.CanCollide = false
	ring.Transparency = 0.2
	ring.Size = Vector3.new(0.25, 3.5, 3.5)
	ring.CFrame = CFrame.new(rootPart.Position - Vector3.new(0, 1.4, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace

	local tween = TweenService:Create(
		ring,
		TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Size = Vector3.new(0.08, 14, 14), Transparency = 1 }
	)
	tween:Play()
	tween.Completed:Connect(function()
		ring:Destroy()
		suite.AnimBusy = false
	end)

	local cam = workspace.CurrentCamera
	if cam then
		local baseFov = cam.FieldOfView
		local peakFov = math.clamp(baseFov - suite.Config.FovPulse, 40, 110)
		local t1 = TweenService:Create(cam, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = peakFov })
		local t2 = TweenService:Create(cam, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { FieldOfView = baseFov })
		t1:Play()
		t1.Completed:Wait()
		if workspace.CurrentCamera then
			t2:Play()
		end
	end
end

local function faceAndRepelThreat(rootPart: BasePart, preferredTarget: BasePart?)
	local chosen = preferredTarget
	if not chosen then
		local bestDist = suite.Config.ThreatRadius
		for _, t in ipairs(suite.Api.GetTargets("ALL")) do
			local d = (t.root.Position - rootPart.Position).Magnitude
			if d < bestDist then
				bestDist = d
				chosen = t.root
			end
		end
	end

	if chosen then
		local flat = Vector3.new(chosen.Position.X - rootPart.Position.X, 0, chosen.Position.Z - rootPart.Position.Z)
		if flat.Magnitude > 0.05 then
			local unit = flat.Unit
			pcall(function()
				rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + unit)
				chosen.AssemblyLinearVelocity = unit * suite.Config.CounterImpulse + Vector3.new(0, 15, 0)
			end)
		end
	end
end

local function raiseAutoBlock(rootPart: BasePart, attackerRoot: BasePart?, statusText: string)
	if not suite.AutoGuardEnabled then
		return
	end
	local now = os.clock()
	local wasUp = suite.IsBlocking
	suite.IsBlocking = true
	suite.BlockUntil = math.max(suite.BlockUntil, now + suite.Config.BlockDuration)
	suite.ParryWindowUntil = math.max(suite.ParryWindowUntil, now + suite.Config.ParryWindow)

	if not wasUp then
		suite.BlockCount += 1
	end

	suite.LastEvent = statusText
	faceAndRepelThreat(rootPart, attackerRoot)
	suite.Api.SyncShield(rootPart)
	if suite.Api.RefreshHud then
		suite.Api.RefreshHud()
	end
end

local function performAutoParry(humanoid: Humanoid, rootPart: BasePart, recoveredHp: number)
	local now = os.clock()
	suite.ParryWindowUntil = 0
	suite.CooldownUntil = now + suite.Config.Cooldown
	suite.IsBlocking = true
	suite.BlockUntil = math.max(suite.BlockUntil, now + suite.Config.BlockDuration)
	suite.ParryCount += 1
	suite.LastEvent = string.format("¡Parry #%d! (+%.0f HP)", suite.ParryCount, recoveredHp)

	if recoveredHp > 0 then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + recoveredHp)
	end
	suite.LastHealth = humanoid.Health

	faceAndRepelThreat(rootPart, nil)
	task.spawn(playParryFeedback, rootPart)
	suite.Api.SyncShield(rootPart)
	if suite.Api.RefreshHud then
		suite.Api.RefreshHud()
	end
end

function suite.Api.ScanAndDefendLord()
	if not suite.AutoGuardEnabled then
		return
	end
	local _, humanoid, rootPart = suite.GetLordRig()
	if not humanoid or not rootPart then
		return
	end

	local now = os.clock()
	if now < suite.CooldownUntil then
		return
	end

	for _, t in ipairs(suite.Api.GetTargets("ALL")) do
		local toLord = rootPart.Position - t.root.Position
		local dist = toLord.Magnitude
		if dist <= suite.Config.ThreatRadius and dist > 0.01 then
			local dir = toLord.Unit
			local approachSpeed = t.root.AssemblyLinearVelocity:Dot(dir)
			local aimingAtLord = t.root.CFrame.LookVector:Dot(dir) > 0.50

			if (approachSpeed >= suite.Config.ThreatApproachSpeed and dist <= 16) or (aimingAtLord and dist <= 10) then
				local label = t.isPlayer and "Jugador" or "NPC"
				raiseAutoBlock(rootPart, t.root, string.format("Bloqueo vs %s (%s)", t.model.Name, label))
				break
			end
		end
	end
end

function suite.Api.BindLord(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end

	suite.LastHealth = humanoid.Health

	suite.Track(humanoid.HealthChanged:Connect(function(newHp: number)
		local prevHp = suite.LastHealth or newHp
		suite.LastHealth = newHp

		local lost = prevHp - newHp
		if lost < suite.Config.MinDamageThreshold or newHp <= 0 or not suite.AutoGuardEnabled then
			return
		end

		local _, _, rootPart = suite.GetLordRig()
		if not rootPart then
			return
		end

		if os.clock() >= suite.CooldownUntil then
			performAutoParry(humanoid, rootPart, lost)
		else
			raiseAutoBlock(rootPart, nil, "Bloqueo de emergencia")
		end
	end))
end

