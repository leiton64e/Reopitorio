suite.Track(UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if gameProcessed then
		return
	end
	if input.KeyCode == suite.Config.ToggleGuardKey then
		toggleGuard()
	elseif input.KeyCode == suite.Config.ToggleEspKey then
		toggleEsp()
	elseif input.KeyCode == suite.Config.CycleFilterKey then
		cycleFilter()
	end
end))

local lastScan, lastEsp, lastHud = 0, 0, 0
suite.Track(RunService.RenderStepped:Connect(function()
	local now = os.clock()
	local _, _, lordRoot = suite.GetLordRig()

	if suite.IsBlocking and now > suite.BlockUntil then
		suite.IsBlocking = false
		if suite.Api.ClearShield then
			suite.Api.ClearShield()
		end
	end

	if suite.IsBlocking and lordRoot and suite.Api.SyncShield then
		suite.Api.SyncShield(lordRoot)
	end

	if now - lastScan >= suite.Config.ScanInterval and suite.Api.ScanAndDefendLord then
		lastScan = now
		suite.Api.ScanAndDefendLord()
	end

	if now - lastEsp >= suite.Config.EspInterval and suite.Api.UpdateEsp then
		lastEsp = now
		suite.Api.UpdateEsp()
	end

	if now - lastHud >= suite.Config.HudInterval and suite.Api.RefreshHud then
		lastHud = now
		suite.Api.RefreshHud()
	end
end))

if localPlayer.Character and suite.Api.BindLord then
	task.spawn(suite.Api.BindLord, localPlayer.Character)
end
suite.Track(localPlayer.CharacterAdded:Connect(function(char: Model)
	if suite.Api.BindLord then
		suite.Api.BindLord(char)
	end
end))

suite.Cleanup = function()
	for _, c in ipairs(suite.Connections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	table.clear(suite.Connections)
	if suite.Api.ClearAllEsp then
		suite.Api.ClearAllEsp()
	end
	if suite.Api.ClearShield then
		suite.Api.ClearShield()
	end
	if suite.Gui then
		pcall(function()
			suite.Gui:Destroy()
		end)
		suite.Gui = nil
	end
end

buildHud()
suite.Api.RefreshHud()
if suite.Api.UpdateEsp then
	suite.Api.UpdateEsp()
end
