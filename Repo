function suite.Track(conn: RBXScriptConnection): RBXScriptConnection
	table.insert(suite.Connections, conn)
	return conn
end

function suite.GetUiRoot(): Instance
	local root: Instance = CoreGui
	pcall(function()
		if typeof(gethui) == "function" then
			local custom = gethui()
			if typeof(custom) == "Instance" then
				root = custom
			end
		end
	end)
	return root
end

function suite.GetLordRig()
	local char = localPlayer.Character
	if not char then
		return nil, nil, nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = (char:FindFirstChild("HumanoidRootPart") :: BasePart?) or (char.PrimaryPart :: BasePart?)
	if not hum or not root or hum.Health <= 0 then
		return nil, nil, nil
	end
	return char, hum, root
end

